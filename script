  <script>
    // Initialize or load rooms from localStorage
    let rooms = JSON.parse(localStorage.getItem('pms_rooms')) || [
      { number: "101", type: "Standard Queen", guest: "Ama Serwaa", status: "occupied", bookingStatus: "approved", paymentStatus: "paid", nights: 3, rate: 400, cleaner: "Akosua" },
      { number: "102", type: "Standard Queen", guest: "-", status: "clean", bookingStatus: "approved", paymentStatus: "paid", nights: 0, rate: 400, cleaner: "Yaw" },
      { number: "103", type: "Deluxe King", guest: "-", status: "dirty", bookingStatus: "approved", paymentStatus: "paid", nights: 0, rate: 650, cleaner: "Abena" },
      { number: "201", type: "Executive Suite", guest: "Kofi Boateng", status: "occupied", bookingStatus: "pending", paymentStatus: "pending", nights: 5, rate: 1200, cleaner: "Kojo" },
      { number: "202", type: "Twin Room", guest: "-", status: "clean", bookingStatus: "approved", paymentStatus: "paid", nights: 0, rate: 450, cleaner: "Akosua" },
      { number: "203", type: "Deluxe King", guest: "Yaw Mensah", status: "occupied", bookingStatus: "pending", paymentStatus: "pending", nights: 2, rate: 650, cleaner: "Yaw" }
    ];

    let currentTab = 'frontdesk';
    let searchQuery = '';

    function saveState() {
      localStorage.setItem('pms_rooms', JSON.stringify(rooms));
      renderAll();
    }

    function toggleMobileMenu() {
      const drawer = document.getElementById("mobileDrawer");
      const icon = document.getElementById("mobileMenuIcon");
      drawer.classList.toggle("hidden");
      if (drawer.classList.contains("hidden")) {
        icon.className = "fa-solid fa-bars text-lg";
      } else {
        icon.className = "fa-solid fa-xmark text-lg";
      }
    }

    function closeMobileMenu() {
      document.getElementById("mobileDrawer").classList.add("hidden");
      document.getElementById("mobileMenuIcon").className = "fa-solid fa-bars text-lg";
    }

    function switchTab(tabId) {
      currentTab = tabId;
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      const target = document.getElementById(`tab-${tabId}`);
      if (target) target.classList.remove('hidden');

      // Update Desktop Sidebar buttons
      document.querySelectorAll('.desktop-nav-btn').forEach(btn => {
        if (btn.getAttribute('data-tab') === tabId) {
          btn.className = "desktop-nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-left bg-blue-600 text-white shadow-lg shadow-blue-600/20";
        } else {
          btn.className = "desktop-nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-left hover:bg-slate-800 text-slate-300";
        }
      });

      // Update Mobile Bottom Nav buttons
      const tabs = ['frontdesk', 'bookings', 'housekeeping', 'billing', 'management'];
      tabs.forEach(t => {
        const bBtn = document.getElementById(`bnav-${t}`);
        if (bBtn) {
          if (t === tabId) {
            bBtn.className = "flex flex-col items-center justify-center flex-1 py-1 text-blue-600 font-semibold transition";
          } else {
            bBtn.className = "flex flex-col items-center justify-center flex-1 py-1 text-slate-500 hover:text-slate-900 transition";
          }
        }
      });

      const titles = {
        frontdesk: "Front Desk & Room Operations",
        housekeeping: "Housekeeping & Maintenance",
        bookings: "Guest Bookings & Approvals",
        billing: "Guest Billing & Folios",
        management: "Room Inventory & Configuration"
      };
      const titleEl = document.getElementById("currentTabTitle");
      if (titleEl) titleEl.innerText = titles[tabId];

      renderAll();
    }

    function renderStats() {
      const total = rooms.length;
      const occupied = rooms.filter(r => r.status === "occupied").length;
      const clean = rooms.filter(r => r.status === "clean").length;
      const dirty = rooms.filter(r => r.status === "dirty").length;
      const pendingBookings = rooms.filter(r => r.status === "occupied" && r.bookingStatus === "pending").length;

      const statsBar = document.getElementById("statsBar");
      if (statsBar) {
        statsBar.innerHTML = `
          <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <div class="text-[10px] md:text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Rooms</div>
              <div class="text-xl md:text-2xl font-bold text-slate-900 mt-1">${total}</div>
            </div>
            <div class="w-9 h-9 md:w-10 md:h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600"><i class="fa-solid fa-door-open"></i></div>
          </div>
          <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <div class="text-[10px] md:text-xs font-semibold text-slate-400 uppercase tracking-wider">Pending Bookings</div>
              <div class="text-xl md:text-2xl font-bold text-amber-600 mt-1">${pendingBookings}</div>
            </div>
            <div class="w-9 h-9 md:w-10 md:h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600"><i class="fa-solid fa-clock"></i></div>
          </div>
          <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <div class="text-[10px] md:text-xs font-semibold text-slate-400 uppercase tracking-wider">Clean & Ready</div>
              <div class="text-xl md:text-2xl font-bold text-emerald-600 mt-1">${clean}</div>
            </div>
            <div class="w-9 h-9 md:w-10 md:h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600"><i class="fa-solid fa-sparkles"></i></div>
          </div>
          <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
              <div class="text-[10px] md:text-xs font-semibold text-slate-400 uppercase tracking-wider">Needs Cleaning</div>
              <div class="text-xl md:text-2xl font-bold text-amber-600 mt-1">${dirty}</div>
            </div>
            <div class="w-9 h-9 md:w-10 md:h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600"><i class="fa-solid fa-broom"></i></div>
          </div>
        `;
      }
    }

    function renderRoomsGrid() {
      const q = searchQuery.toLowerCase();
      const filtered = rooms.filter(r =>
        r.number.toLowerCase().includes(q) ||
        r.type.toLowerCase().includes(q) ||
        r.guest.toLowerCase().includes(q)
      );

      const grid = document.getElementById("roomCardsGrid");
      if (!grid) return;

      if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-span-2 text-center py-10 text-slate-400 text-sm">No rooms match your search query.</div>`;
        return;
      }

      grid.innerHTML = filtered.map(r => {
        let statusBadge = '';
        let actionBtn = '';
        if (r.status === 'occupied') {
          const bookingBadge = r.bookingStatus === 'pending' 
            ? `<span class="px-2 py-0.5 bg-amber-50 text-amber-700 text-[10px] font-bold rounded-md border border-amber-200">Booking: Pending</span>`
            : `<span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 text-[10px] font-bold rounded-md border border-emerald-200">Booking: Approved</span>`;
          
          statusBadge = `
            <div class="flex flex-col items-end gap-1">
              <span class="px-2.5 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-lg flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span> Occupied</span>
              ${bookingBadge}
            </div>
          `;

          const approveBtn = r.bookingStatus === 'pending'
            ? `<button onclick="approveBooking('${r.number}')" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg shadow-xs transition">Approve</button>`
            : '';

          actionBtn = `
            <div class="flex items-center space-x-2">
              ${approveBtn}
              <button onclick="checkoutRoom('${r.number}')" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition">Check Out</button>
            </div>
          `;
        } else if (r.status === 'clean') {
          statusBadge = `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-lg flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Clean</span>`;
          actionBtn = `<button onclick="markDirty('${r.number}')" class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 text-xs font-semibold rounded-lg transition">Mark Dirty</button>`;
        } else {
          statusBadge = `<span class="px-2.5 py-1 bg-amber-50 text-amber-700 text-xs font-bold rounded-lg flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> Needs Cleaning</span>`;
          actionBtn = `<button onclick="markClean('${r.number}')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg shadow-xs transition">Mark Clean</button>`;
        }

        return `
          <div class="border border-slate-200 rounded-xl p-4 flex flex-col justify-between space-y-3 hover:border-slate-300 transition bg-slate-50/50">
            <div class="flex items-start justify-between">
              <div>
                <div class="flex items-center space-x-2">
                  <span class="font-bold text-base text-slate-900">Room ${r.number}</span>
                  <span class="text-xs text-slate-500 font-medium">(${r.type})</span>
                </div>
                <div class="text-xs text-slate-600 mt-1">Guest: <strong class="text-slate-900">${r.guest}</strong></div>
              </div>
              <div>${statusBadge}</div>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-slate-200/60 text-xs text-slate-500">
              <div>Rate: <strong>GH₵ ${r.rate}/night</strong></div>
              <div class="flex items-center space-x-2">
                ${actionBtn}
                <button onclick="deleteBookingOrRoom('${r.number}')" title="Cancel booking or reset room" class="text-slate-400 hover:text-red-600 p-1.5 transition"><i class="fa-solid fa-trash-can"></i></button>
              </div>
            </div>
          </div>
        `;
      }).join("");

      const select = document.getElementById("quickRoomSelect");
      if (select) {
        const cleanRooms = rooms.filter(r => r.status === "clean");
        if (cleanRooms.length > 0) {
          select.innerHTML = cleanRooms.map(r => `<option value="${r.number}">Room ${r.number} - ${r.type} (GH₵ ${r.rate})</option>`).join("");
        } else {
          select.innerHTML = `<option value="">No clean rooms available</option>`;
        }
      }
    }

    let currentHousekeepingFilter = 'all';
    function filterHousekeeping(filter) {
      currentHousekeepingFilter = filter;
      document.querySelectorAll('.hk-filter-btn').forEach(btn => btn.classList.remove('bg-slate-900', 'text-white'));
      event.target.classList.add('bg-slate-900', 'text-white');
      renderHousekeepingTable();
    }

    function renderHousekeepingTable() {
      const tbody = document.getElementById("housekeepingTableBody");
      if (!tbody) return;

      let filtered = rooms;
      if (currentHousekeepingFilter === 'clean') filtered = rooms.filter(r => r.status === 'clean');
      if (currentHousekeepingFilter === 'dirty') filtered = rooms.filter(r => r.status === 'dirty' || r.status === 'occupied');

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-6 text-center text-slate-400 text-sm">No rooms found for this housekeeping filter.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map(r => `
        <tr class="hover:bg-slate-50/80 transition">
          <td class="px-6 py-4 font-bold text-slate-900">Room ${r.number}</td>
          <td class="px-6 py-4 text-slate-600">${r.type}</td>
          <td class="px-6 py-4">
            ${r.status === 'clean' ? '<span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold">Clean & Ready</span>' :
              r.status === 'occupied' ? '<span class="px-2.5 py-1 bg-blue-50 text-blue-700 rounded-lg text-xs font-bold">Occupied (In Use)</span>' :
              '<span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg text-xs font-bold">Needs Cleaning</span>'}
          </td>
          <td class="px-6 py-4 text-slate-600"><span class="bg-slate-100 px-2.5 py-1 rounded-md text-xs font-medium">${r.cleaner || 'Unassigned'}</span></td>
          <td class="px-6 py-4 text-right space-x-2">
            ${r.status !== 'clean' ? `<button onclick="markClean('${r.number}')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold shadow-xs transition">Set Clean</button>` : `<button onclick="markDirty('${r.number}')" class="px-3 py-1.5 bg-amber-100 hover:bg-amber-200 text-amber-800 rounded-lg text-xs font-semibold transition">Set Dirty</button>`}
          </td>
        </tr>
      `).join("");
    }

    function renderBookingsTable() {
      const tbody = document.getElementById("bookingsTableBody");
      if (!tbody) return;

      const activeBookings = rooms.filter(r => r.guest !== "-");

      if (activeBookings.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-6 text-center text-slate-400 text-sm">No active bookings or checked-in guests found.</td></tr>`;
        return;
      }

      tbody.innerHTML = activeBookings.map(r => {
        const bStatus = r.bookingStatus || 'approved';
        const badge = bStatus === 'approved'
          ? `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold">Approved</span>`
          : `<span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg text-xs font-bold">Pending Approval</span>`;

        const approveBtn = bStatus === 'pending'
          ? `<button onclick="approveBooking('${r.number}')" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-xs font-semibold shadow-xs transition mr-2">Approve</button>`
          : '';

        return `
          <tr class="hover:bg-slate-50/80 transition">
            <td class="px-6 py-4 font-bold text-slate-900">Room ${r.number}</td>
            <td class="px-6 py-4 font-semibold text-slate-800">${r.guest}</td>
            <td class="px-6 py-4 text-slate-600">${r.nights || 1} Nights</td>
            <td class="px-6 py-4">${badge}</td>
            <td class="px-6 py-4 text-right whitespace-nowrap">
              ${approveBtn}
              <button onclick="deleteBookingOrRoom('${r.number}')" class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg text-xs font-semibold transition"><i class="fa-solid fa-trash mr-1"></i> Cancel</button>
            </td>
          </tr>
        `;
      }).join("");
    }

    function renderBillingTable() {
      const tbody = document.getElementById("billingTableBody");
      if (!tbody) return;

      const occupiedRooms = rooms.filter(r => r.status === 'occupied');

      if (occupiedRooms.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-6 text-center text-slate-400 text-sm">No active guest folios found. All rooms checked out.</td></tr>`;
        return;
      }

      tbody.innerHTML = occupiedRooms.map(r => {
        const totalBill = (r.nights || 1) * (r.rate || 400);
        const payStatus = r.paymentStatus || 'pending';
        const paymentBadge = payStatus === 'paid'
          ? `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold">Paid</span>`
          : `<span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg text-xs font-bold">Pending Payment</span>`;

        const paymentAction = payStatus === 'pending'
          ? `<button onclick="markPaymentPaid('${r.number}')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-xs transition mr-2">Mark Paid</button>`
          : '';

        return `
          <tr class="hover:bg-slate-50/80 transition">
            <td class="px-6 py-4 font-bold text-slate-900">Room ${r.number}</td>
            <td class="px-6 py-4 font-semibold text-slate-800">${r.guest}</td>
            <td class="px-6 py-4 text-slate-600">${r.nights || 1} Nights @ GH₵ ${r.rate}</td>
            <td class="px-6 py-4 font-bold text-blue-600">GH₵ ${totalBill.toLocaleString()}</td>
            <td class="px-6 py-4">${paymentBadge}</td>
            <td class="px-6 py-4 text-right whitespace-nowrap">
              ${paymentAction}
              <button onclick="settleFolio('${r.number}', ${totalBill})" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-semibold shadow-xs transition">Checkout</button>
            </td>
          </tr>
        `;
      }).join("");
    }

    function renderInventoryTable() {
      const tbody = document.getElementById("inventoryTableBody");
      if (!tbody) return;

      tbody.innerHTML = rooms.map(r => `
        <tr class="hover:bg-slate-50/80 transition">
          <td class="px-6 py-4 font-bold text-slate-900">Room ${r.number}</td>
          <td class="px-6 py-4 text-slate-600">${r.type}</td>
          <td class="px-6 py-4 text-slate-600">GH₵ ${r.rate}</td>
          <td class="px-6 py-4 capitalize"><span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-lg text-xs font-bold">${r.status}</span></td>
          <td class="px-6 py-4 text-right space-x-2">
            <button onclick="deleteRoomCompletely('${r.number}')" class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg text-xs font-semibold transition"><i class="fa-solid fa-trash mr-1"></i> Delete</button>
          </td>
        </tr>
      `).join("");
    }

    function renderAll() {
      renderStats();
      renderRoomsGrid();
      renderHousekeepingTable();
      renderBookingsTable();
      renderBillingTable();
      renderInventoryTable();
    }

    function handleCheckIn(e) {
      e.preventDefault();
      const name = document.getElementById("quickGuestName").value.trim();
      const roomNum = document.getElementById("quickRoomSelect").value;
      const nights = parseInt(document.getElementById("quickNights").value) || 2;
      const rate = parseInt(document.getElementById("quickRate").value) || 450;
      const bookingStatus = document.getElementById("quickBookingStatus").value;
      const paymentStatus = document.getElementById("quickPaymentStatus").value;

      if (!name || !roomNum) {
        showModal("Check-In Error", "Please provide guest name and select a clean room.");
        return;
      }

      const room = rooms.find(r => r.number === roomNum);
      if (room) {
        room.guest = name;
        room.status = "occupied";
        room.bookingStatus = bookingStatus;
        room.paymentStatus = paymentStatus;
        room.nights = nights;
        room.rate = rate;
        saveState();
        e.target.reset();
        showModal("Success", `Guest <strong>${name}</strong> checked into Room ${roomNum}.`);
      }
    }

    function approveBooking(roomNum) {
      const room = rooms.find(r => r.number === roomNum);
      if (room) {
        room.bookingStatus = 'approved';
        saveState();
        showModal("Booking Approved", `Booking for Room ${roomNum} is now approved.`);
      }
    }

    function markPaymentPaid(roomNum) {
      const room = rooms.find(r => r.number === roomNum);
      if (room) {
        room.paymentStatus = 'paid';
        saveState();
        showModal("Payment Updated", `Payment status for Room ${roomNum} has been marked as <strong>Paid</strong>.`);
      }
    }

    function checkoutRoom(roomNum) {
      const room = rooms.find(r => r.number === roomNum);
      if (room) {
        room.guest = "-";
        room.status = "dirty";
        room.bookingStatus = "approved";
        room.paymentStatus = "pending";
        room.nights = 0;
        saveState();
        showModal("Checked Out", `Room ${roomNum} has been checked out and marked as dirty.`);
      }
    }

    function settleFolio(roomNum, amount) {
      const room = rooms.find(r => r.number === roomNum);
      if (room) {
        room.guest = "-";
        room.status = "dirty";
        room.bookingStatus = "approved";
        room.paymentStatus = "pending";
        room.nights = 0;
        saveState();
        showModal("Payment Settled", `Payment of <strong>GH₵ ${amount.toLocaleString()}</strong> processed. Room ${roomNum} checked out.`);
      }
    }

    function markClean(roomNum) {
      const room = rooms.find(r => r.number === roomNum);
      if (room) {
        room.status = "clean";
        saveState();
      }
    }

    function markDirty(roomNum) {
      const room = rooms.find(r => r.number === roomNum);
      if (room) {
        room.status = "dirty";
        saveState();
      }
    }

    function deleteBookingOrRoom(roomNum) {
      const room = rooms.find(r => r.number === roomNum);
      if (!room) return;

      if (confirm(`Cancel booking for Room ${roomNum} and reset to vacant/clean?`)) {
        room.guest = "-";
        room.status = "clean";
        room.bookingStatus = "approved";
        room.paymentStatus = "pending";
        room.nights = 0;
        saveState();
        showModal("Booking Cancelled", `Booking for Room ${roomNum} was cancelled.`);
      }
    }

    function deleteRoomCompletely(roomNum) {
      if (confirm(`Are you sure you want to remove Room ${roomNum} from inventory?`)) {
        rooms = rooms.filter(r => r.number !== roomNum);
        saveState();
        showModal("Room Deleted", `Room ${roomNum} removed from inventory.`);
      }
    }

    function handleAddRoom(event) {
      event.preventDefault();
      const number = document.getElementById("newRoomNumber").value.trim();
      const type = document.getElementById("newRoomType").value;
      const rate = parseInt(document.getElementById("newRoomRate").value) || 500;

      if (rooms.some(r => r.number === number)) {
        showModal("Duplicate Room", `Room number ${number} already exists.`);
        return;
      }

      rooms.push({ number, type, guest: "-", status: "clean", bookingStatus: "approved", paymentStatus: "pending", nights: 0, rate, cleaner: "Staff" });
      saveState();
      event.target.reset();
      showModal("Room Added", `Room ${number} (${type}) added successfully.`);
    }

    function handleSearch() {
      searchQuery = document.getElementById("searchInput").value;
      renderRoomsGrid();
    }

    function handleSearchMobile() {
      searchQuery = document.getElementById("mobileSearchInput").value;
      renderRoomsGrid();
    }

    function showModal(title, htmlBody) {
      document.getElementById("modalTitle").innerHTML = title;
      document.getElementById("modalBody").innerHTML = htmlBody;
      document.getElementById("customModal").classList.remove("hidden");
    }

    function closeModal() {
      document.getElementById("customModal").classList.add("hidden");
    }

    window.onload = function() {
      renderAll();
    };
  </script>